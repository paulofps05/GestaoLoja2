@layout AdminLayout
@page "/categoria"
@using GestaoLoja2.Components.Layout
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using GestaoLoja2.Entitles
@using GestaoLoja2.Data
@using GestaoLoja2.Services
@implements IAsyncDisposable
@inject CategoriaService categoriaService

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin, Gestor")]

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<AuthorizeView Roles="Admin">
    <Authorized>
		<p>
			<a href="categoria/create">Create New</a>
		</p>
    </Authorized>
</AuthorizeView>


<QuickGrid Class="table" Items="categorias.AsQueryable()">
    @* <PropertyColumn Property="categoria => categoria.UrlImagem" /> *@
	@*<PropertyColumn Property="categoria => categoria.Imagem" />*@

    <TemplateColumn Context="categoria">
        @if (categoria.Imagem is not null && categoria.Imagem.Length > 4)
        {
            <img src="@($"data:image/png;base64,{Convert.ToBase64String(categoria.Imagem)}")" alt="@categoria.Nome
            " style="max-width: 100px; max-height: 100px" />
        } else {
            <a>Sem imagem...</a>
        }
    </TemplateColumn>

    <PropertyColumn Property="categoria => categoria.Nome" />
    @* <PropertyColumn Property="categoria => categoria.Ordem" /> *@

    <TemplateColumn Context="categoria">
        <a href="@($"categoria/edit?id={categoria.Id}")">Edit</a> |
        <a href="@($"categoria/details?id={categoria.Id}")">Details</a> |
        <a href="@($"categoria/delete?id={categoria.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>



@code {

    IEnumerable<categoria> categorias = Enumerable.Empty<categoria>();

    protected override async Task OnInitializedAsync()
    {
        categorias = await categoriaService.GetCategorias();
    }

    public async ValueTask DisposeAsync() => categorias = Enumerable.Empty<categoria>();
}
